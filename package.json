{
  "name": "daneo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "tsx watch server/index.ts",
    "validate:content": "vitest run tests/content.validate.test.ts",
    "tauri": "tauri",
    "lint": "oxlint",
    "tauri:build": "npm run check:version && cd src-tauri && NO_STRIP=true ../node_modules/.bin/tauri build --bundles appimage,rpm",
    "check:version": "node scripts/check-version.mjs",
    "coverage:nikl": "tsx scripts/nikl-coverage.ts",
    "ring2:plan": "tsx scripts/ring2-plan.ts",
    "ring3:plan": "tsx scripts/ring2-plan.ts -- --ring 3",
    "visual:pass": "node scripts/visual-pass.mjs",
    "lint:lang": "python3 reference/authoring/lint_language.py --shipped"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@tauri-apps/api": "^2.12.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.12.33",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
