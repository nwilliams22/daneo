  { "id": "w_hakgyo", "ko": "학교", "rom": "hakgyo", "en": "school", "pos": "noun", "moduleId": "m1" },
  { "id": "w_gage", "ko": "가게", "rom": "gage", "en": "store / shop", "pos": "noun", "moduleId": "m1", "notes": "Added alongside the original 35 so the sentence-anatomy example works. A useful everyday word." },
  { "id": "w_chaek", "ko": "책", "rom": "chaek", "en": "book", "pos": "noun", "moduleId": "m1" },
  { "id": "w_sigan", "ko": "시간", "rom": "sigan", "en": "time", "pos": "noun", "moduleId": "m1" },
