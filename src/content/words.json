  { "id": "w_jeo", "ko": "저", "rom": "jeo", "en": "I / me (polite)", "pos": "noun", "moduleId": "m1", "notes": "With subject particle 가 it becomes 제가 (irregular)." },
  { "id": "w_na", "ko": "나", "rom": "na", "en": "I / me (casual)", "pos": "noun", "moduleId": "m1", "notes": "With subject particle 가 it becomes 내가 (irregular)." },
