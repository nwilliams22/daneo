  { "id": "w_hangugeo", "ko": "한국어", "rom": "hangugeo", "en": "the Korean language", "pos": "noun", "moduleId": "m1" },
  { "id": "w_meokda", "ko": "먹다", "rom": "meokda", "en": "to eat", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 먹어요 (meogeoyo)." },
  { "id": "w_masida", "ko": "마시다", "rom": "masida", "en": "to drink", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 마셔요 (masyeoyo)." },
  { "id": "w_gada", "ko": "가다", "rom": "gada", "en": "to go", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 가요 (gayo)." },
  { "id": "w_oda", "ko": "오다", "rom": "oda", "en": "to come", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 와요 (wayo)." },
  { "id": "w_boda", "ko": "보다", "rom": "boda", "en": "to see / watch", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 봐요 (bwayo)." },
  { "id": "w_hada", "ko": "하다", "rom": "hada", "en": "to do", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 해요 (haeyo). Any ~하다 verb conjugates the same way." },
  { "id": "w_gongbuhada", "ko": "공부하다", "rom": "gongbuhada", "en": "to study", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 공부해요 (gongbuhaeyo)." },
  { "id": "w_joahada", "ko": "좋아하다", "rom": "joahada", "en": "to like", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 좋아해요 (joahaeyo)." },
  { "id": "w_itda", "ko": "있다", "rom": "itda", "en": "to exist / to have", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 있어요 (isseoyo). Korean has no separate everyday verb for possession — things simply exist (for you)." },
  { "id": "w_eopda", "ko": "없다", "rom": "eopda", "en": "to not exist / not have", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 없어요 (eopseoyo)." },
  { "id": "w_jada", "ko": "자다", "rom": "jada", "en": "to sleep", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 자요 (jayo)." },
  { "id": "w_jota", "ko": "좋다", "rom": "jota", "en": "to be good", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 좋아요 (joayo). Korean describing words behave like verbs." },
  { "id": "w_masitda", "ko": "맛있다", "rom": "masitda", "en": "to be delicious", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 맛있어요 (masisseoyo). Literally 맛 (taste) + 있다 (exists)." },
  { "id": "w_yeppeuda", "ko": "예쁘다", "rom": "yeppeuda", "en": "to be pretty", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 예뻐요 (yeppeoyo)." },
  { "id": "w_keuda", "ko": "크다", "rom": "keuda", "en": "to be big", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 커요 (keoyo)." },
  { "id": "w_jakda", "ko": "작다", "rom": "jakda", "en": "to be small", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 작아요 (jagayo)." },
  { "id": "w_annyeonghaseyo", "ko": "안녕하세요", "rom": "annyeonghaseyo", "en": "hello", "pos": "phrase", "moduleId": "m1", "notes": "The standard polite greeting. Between close friends it shortens to just 안녕 (annyeong)." },
  { "id": "w_gamsahamnida", "ko": "감사합니다", "rom": "gamsahamnida", "en": "thank you (formal)", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_gomawoyo", "ko": "고마워요", "rom": "gomawoyo", "en": "thanks (casual-polite)", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_ne", "ko": "네", "rom": "ne", "en": "yes", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_aniyo", "ko": "아니요", "rom": "aniyo", "en": "no", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_p_eun", "ko": "은", "rom": "eun", "en": "topic particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "\"As for ___\": 밥은 (bap-eun)." },
  { "id": "w_p_neun", "ko": "는", "rom": "neun", "en": "topic particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "\"As for ___\": 저는 (jeo-neun)." },
  { "id": "w_p_i", "ko": "이", "rom": "i", "en": "subject particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "사람이 (saram-i)." },
  { "id": "w_p_ga", "ko": "가", "rom": "ga", "en": "subject particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "친구가 (chingu-ga). Irregulars: 저+가 → 제가, 나+가 → 내가." },
  { "id": "w_p_eul", "ko": "을", "rom": "eul", "en": "object particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "밥을 (bap-eul)." },
  { "id": "w_p_reul", "ko": "를", "rom": "reul", "en": "object particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "커피를 (keopi-reul)." },
  { "id": "w_p_e", "ko": "에", "rom": "e", "en": "location particle — to / at", "pos": "particle", "moduleId": "m1", "notes": "집에 (jip-e, \"to home\"), 학교에 (hakgyo-e, \"to school\")." },

  { "id": "w_n_il", "ko": "일", "rom": "il", "en": "one (1)", "pos": "noun", "moduleId": "m2", "notes": "Sino-Korean. Also means \"day\" and \"work\" — context decides." },
  { "id": "w_n_i", "ko": "이", "rom": "i", "en": "two (2)", "pos": "noun", "moduleId": "m2", "notes": "Sino-Korean. Looks like 일 (1) minus the ㄹ — a classic mix-up." },
  { "id": "w_n_sam", "ko": "삼", "rom": "sam", "en": "three (3)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_sa", "ko": "사", "rom": "sa", "en": "four (4)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_o", "ko": "오", "rom": "o", "en": "five (5)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_yuk", "ko": "육", "rom": "yuk", "en": "six (6)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_chil", "ko": "칠", "rom": "chil", "en": "seven (7)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_pal", "ko": "팔", "rom": "pal", "en": "eight (8)", "pos": "noun", "moduleId": "m2", "notes": "Also means \"arm\"." },
  { "id": "w_n_gu", "ko": "구", "rom": "gu", "en": "nine (9)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_sip", "ko": "십", "rom": "sip", "en": "ten (10)", "pos": "noun", "moduleId": "m2", "notes": "Stack to count: 십일 11, 이십 20, 이십일 21 … 구십구 99." },

  { "id": "w_oneul", "ko": "오늘", "rom": "oneul", "en": "today", "pos": "noun", "moduleId": "m2" },
  { "id": "w_eoje", "ko": "어제", "rom": "eoje", "en": "yesterday", "pos": "noun", "moduleId": "m2" },
  { "id": "w_naeil", "ko": "내일", "rom": "naeil", "en": "tomorrow", "pos": "noun", "moduleId": "m2", "notes": "Literally 내(來 coming)+일(day) — \"the coming day\"." },
  { "id": "w_jigeum", "ko": "지금", "rom": "jigeum", "en": "now", "pos": "noun", "moduleId": "m2" },
  { "id": "w_achim", "ko": "아침", "rom": "achim", "en": "morning / breakfast", "pos": "noun", "moduleId": "m2", "notes": "Also means breakfast — 아침 먹었어요? \"had breakfast?\"" },
  { "id": "w_jeonyeok", "ko": "저녁", "rom": "jeonyeok", "en": "evening / dinner", "pos": "noun", "moduleId": "m2", "notes": "Same double duty as 아침: the time and the meal." },
  { "id": "w_jumal", "ko": "주말", "rom": "jumal", "en": "weekend", "pos": "noun", "moduleId": "m2" },

  { "id": "w_kape", "ko": "카페", "rom": "kape", "en": "cafe", "pos": "noun", "moduleId": "m2" },
  { "id": "w_doseogwan", "ko": "도서관", "rom": "doseogwan", "en": "library", "pos": "noun", "moduleId": "m2" },
  { "id": "w_hoesa", "ko": "회사", "rom": "hoesa", "en": "company / the office", "pos": "noun", "moduleId": "m2", "notes": "Koreans say 회사에 가요 (\"go to the company\") for \"go to work\"." },
  { "id": "w_sikdang", "ko": "식당", "rom": "sikdang", "en": "restaurant", "pos": "noun", "moduleId": "m2" },

  { "id": "w_yeonghwa", "ko": "영화", "rom": "yeonghwa", "en": "movie", "pos": "noun", "moduleId": "m2" },
  { "id": "w_eumak", "ko": "음악", "rom": "eumak", "en": "music", "pos": "noun", "moduleId": "m2" },
  { "id": "w_ppang", "ko": "빵", "rom": "ppang", "en": "bread", "pos": "noun", "moduleId": "m2", "notes": "Starts with tense ㅃ — puff-free and tight." },
  { "id": "w_uyu", "ko": "우유", "rom": "uyu", "en": "milk", "pos": "noun", "moduleId": "m2", "notes": "All vowels-with-ㅇ: 우+유. Good ㅜ/ㅠ practice." },
  { "id": "w_cha", "ko": "차", "rom": "cha", "en": "tea", "pos": "noun", "moduleId": "m2", "notes": "Also means \"car\" — context decides." },

  { "id": "w_ikda", "ko": "읽다", "rom": "ikda", "en": "to read", "pos": "verb", "moduleId": "m2", "notes": "Polite: 읽어요 (ilgeoyo) — the buried ㄹ comes back before a vowel." },
  { "id": "w_deutda", "ko": "듣다", "rom": "deutda", "en": "to listen", "pos": "verb", "moduleId": "m2", "notes": "ㄷ-irregular: 들어요 (deureoyo), past 들었어요." },
  { "id": "w_mannada", "ko": "만나다", "rom": "mannada", "en": "to meet", "pos": "verb", "moduleId": "m2", "notes": "Polite: 만나요. Past: 만났어요." },
  { "id": "w_sada", "ko": "사다", "rom": "sada", "en": "to buy", "pos": "verb", "moduleId": "m2", "notes": "Polite: 사요. Past: 샀어요." },
  { "id": "w_baeuda", "ko": "배우다", "rom": "baeuda", "en": "to learn", "pos": "verb", "moduleId": "m2", "notes": "Polite: 배워요 (ㅜ + 어 → 워). Past: 배웠어요." },
  { "id": "w_ilhada", "ko": "일하다", "rom": "ilhada", "en": "to work", "pos": "verb", "moduleId": "m2", "notes": "일 (work) + 하다 (do). Polite: 일해요. Past: 일했어요." },

  { "id": "w_p_do", "ko": "도", "rom": "do", "en": "particle — also / too", "pos": "particle", "moduleId": "m2", "notes": "REPLACES 은/는/이/가/을/를 — never stacks on them: 음악도, not 음악을도." },
  { "id": "w_p_eseo", "ko": "에서", "rom": "eseo", "en": "particle — at / in (where an action happens)", "pos": "particle", "moduleId": "m2", "notes": "카페에서 마셔요 (drink AT the cafe). 에 is the destination; 에서 is the venue." },
  { "id": "w_p_hago", "ko": "하고", "rom": "hago", "en": "particle — and / with", "pos": "particle", "moduleId": "m2", "notes": "우유하고 빵 (milk and bread) · 친구하고 (with a friend)." },

  { "id": "w_jeomsim", "ko": "점심", "rom": "jeomsim", "en": "lunch / midday", "pos": "noun", "moduleId": "m3", "notes": "Completes the meal set with 아침 and 저녁 — and like them, it's both the time and the meal." },
  { "id": "w_gimchi", "ko": "김치", "rom": "gimchi", "en": "kimchi", "pos": "noun", "moduleId": "m3" },
  { "id": "w_gogi", "ko": "고기", "rom": "gogi", "en": "meat", "pos": "noun", "moduleId": "m3", "notes": "Prefix the animal for specifics later: 소고기 beef, 돼지고기 pork." },
  { "id": "w_saengseon", "ko": "생선", "rom": "saengseon", "en": "fish (as food)", "pos": "noun", "moduleId": "m3", "notes": "Fish on a plate. A fish swimming in the sea is 물고기." },
  { "id": "w_gwail", "ko": "과일", "rom": "gwail", "en": "fruit", "pos": "noun", "moduleId": "m3" },
  { "id": "w_sagwa", "ko": "사과", "rom": "sagwa", "en": "apple", "pos": "noun", "moduleId": "m3", "notes": "Also means \"apology\" — 사과해요 is \"I apologize,\" not \"I apple.\"" },
  { "id": "w_banana", "ko": "바나나", "rom": "banana", "en": "banana", "pos": "noun", "moduleId": "m3", "notes": "A loanword that sounds like home. Korean is full of these." },
  { "id": "w_chaeso", "ko": "채소", "rom": "chaeso", "en": "vegetables", "pos": "noun", "moduleId": "m3", "notes": "야채 (yachae) is the everyday synonym you'll also hear." },
  { "id": "w_gyeran", "ko": "계란", "rom": "gyeran", "en": "egg", "pos": "noun", "moduleId": "m3", "notes": "The native-Korean word 달걀 means the same thing." },
  { "id": "w_guk", "ko": "국", "rom": "guk", "en": "soup", "pos": "noun", "moduleId": "m3", "notes": "Everyday soup that comes with rice. Fancier stews are 찌개 and 탕 — later." },
  { "id": "w_ramyeon", "ko": "라면", "rom": "ramyeon", "en": "ramen (instant noodles)", "pos": "noun", "moduleId": "m3" },
  { "id": "w_gimbap", "ko": "김밥", "rom": "gimbap", "en": "gimbap (seaweed rice roll)", "pos": "noun", "moduleId": "m3", "notes": "김 (seaweed) + 밥 (rice) — the name is the recipe." },
  { "id": "w_bulgogi", "ko": "불고기", "rom": "bulgogi", "en": "bulgogi (marinated beef)", "pos": "noun", "moduleId": "m3", "notes": "불 (fire) + 고기 (meat) — \"fire meat.\"" },
  { "id": "w_bibimbap", "ko": "비빔밥", "rom": "bibimbap", "en": "bibimbap (mixed rice bowl)", "pos": "noun", "moduleId": "m3", "notes": "비빔 (mixing) + 밥 (rice). Korean food names are honest." },
  { "id": "w_chikin", "ko": "치킨", "rom": "chikin", "en": "fried chicken", "pos": "noun", "moduleId": "m3", "notes": "The loanword means Korean fried chicken specifically — a national institution." },
  { "id": "w_banchan", "ko": "반찬", "rom": "banchan", "en": "side dishes", "pos": "noun", "moduleId": "m3", "notes": "The small shared plates that cover a Korean table. They refill for free." },
  { "id": "w_sogeum", "ko": "소금", "rom": "sogeum", "en": "salt", "pos": "noun", "moduleId": "m3" },
  { "id": "w_seoltang", "ko": "설탕", "rom": "seoltang", "en": "sugar", "pos": "noun", "moduleId": "m3" },
  { "id": "w_maekju", "ko": "맥주", "rom": "maekju", "en": "beer", "pos": "noun", "moduleId": "m3" },
  { "id": "w_soju", "ko": "소주", "rom": "soju", "en": "soju", "pos": "noun", "moduleId": "m3" },
  { "id": "w_juseu", "ko": "주스", "rom": "juseu", "en": "juice", "pos": "noun", "moduleId": "m3" },
  { "id": "w_menyu", "ko": "메뉴", "rom": "menyu", "en": "menu", "pos": "noun", "moduleId": "m3" },
  { "id": "w_siksa", "ko": "식사", "rom": "siksa", "en": "a meal (slightly formal)", "pos": "noun", "moduleId": "m3", "notes": "식사했어요? is a politer cousin of 밥 먹었어요?" },
  { "id": "w_bae", "ko": "배", "rom": "bae", "en": "stomach / belly", "pos": "noun", "moduleId": "m3", "notes": "Also \"pear\" and \"boat\" — context decides. It's the 배 in 배고프다." },
  { "id": "w_mateu", "ko": "마트", "rom": "mateu", "en": "supermarket", "pos": "noun", "moduleId": "m3", "notes": "From \"mart.\" The big-box grocery store." },
  { "id": "w_sijang", "ko": "시장", "rom": "sijang", "en": "market (traditional)", "pos": "noun", "moduleId": "m3" },

  { "id": "w_maepda", "ko": "맵다", "rom": "maepda", "en": "to be spicy", "pos": "adj", "moduleId": "m3", "notes": "Polite: 매워요 (maewoyo) — the ㅂ softens to 워. A whole ㅂ-irregular family works this way; it gets its own module later." },
  { "id": "w_jjada", "ko": "짜다", "rom": "jjada", "en": "to be salty", "pos": "adj", "moduleId": "m3", "notes": "Polite: 짜요 (jjayo)." },
  { "id": "w_dalda", "ko": "달다", "rom": "dalda", "en": "to be sweet", "pos": "adj", "moduleId": "m3", "notes": "Polite: 달아요 (darayo)." },
  { "id": "w_madeopda", "ko": "맛없다", "rom": "madeopda", "en": "to taste bad", "pos": "adj", "moduleId": "m3", "notes": "Polite: 맛없어요 (madeopseoyo). Literally \"taste doesn't exist\" — the mirror of 맛있다." },
  { "id": "w_baegopeuda", "ko": "배고프다", "rom": "baegopeuda", "en": "to be hungry", "pos": "adj", "moduleId": "m3", "notes": "Polite: 배고파요 (baegopayo) — the ㅡ drops before 아. Literally \"stomach is hungry.\"" },
  { "id": "w_baebureuda", "ko": "배부르다", "rom": "baebureuda", "en": "to be full (after eating)", "pos": "adj", "moduleId": "m3", "notes": "Polite: 배불러요 (baebulleoyo) — a 르-irregular; just memorize this one for now." },
  { "id": "w_silta", "ko": "싫다", "rom": "silta", "en": "to be unwanted / disliked", "pos": "adj", "moduleId": "m3", "notes": "Polite: 싫어요 (sireoyo). The blunt \"no thanks / I don't want it.\"" },

  { "id": "w_yorihada", "ko": "요리하다", "rom": "yorihada", "en": "to cook", "pos": "verb", "moduleId": "m3", "notes": "요리 (cooking) + 하다. Polite: 요리해요. Past: 요리했어요." },
  { "id": "w_jumunhada", "ko": "주문하다", "rom": "jumunhada", "en": "to order (at a restaurant)", "pos": "verb", "moduleId": "m3", "notes": "Polite: 주문해요. Past: 주문했어요." },
  { "id": "w_mandeulda", "ko": "만들다", "rom": "mandeulda", "en": "to make", "pos": "verb", "moduleId": "m3", "notes": "Polite: 만들어요 (mandeureoyo). Past: 만들었어요." },
  { "id": "w_sireohada", "ko": "싫어하다", "rom": "sireohada", "en": "to dislike", "pos": "verb", "moduleId": "m3", "notes": "The verb pair of 싫다, like 좋다/좋아하다. Polite: 싫어해요." },
  { "id": "w_sikida", "ko": "시키다", "rom": "sikida", "en": "to order (food) / have delivered", "pos": "verb", "moduleId": "m3", "notes": "The casual everyday word for ordering in or delivery. Polite: 시켜요 (sikyeoyo)." },

  { "id": "w_p_an", "ko": "안", "rom": "an", "en": "negation adverb — don't / not (by choice)", "pos": "particle", "moduleId": "m3", "notes": "Sits right before the verb: 안 먹어요 \"I don't eat (it).\"" },
  { "id": "w_p_mot", "ko": "못", "rom": "mot", "en": "negation adverb — can't", "pos": "particle", "moduleId": "m3", "notes": "Inability or circumstance, never choice: 못 마셔요 \"I can't drink (it).\"" },

  { "id": "w_gajok", "ko": "가족", "rom": "gajok", "en": "family", "pos": "noun", "moduleId": "m4" },
  { "id": "w_bumonim", "ko": "부모님", "rom": "bumonim", "en": "parents", "pos": "noun", "moduleId": "m4", "notes": "부모 + the respect suffix 님, built right into the word. You basically never drop it." },
  { "id": "w_eomeoni", "ko": "어머니", "rom": "eomeoni", "en": "mother", "pos": "noun", "moduleId": "m4", "notes": "The respectful form. At home you'll mostly hear 엄마." },
  { "id": "w_abeoji", "ko": "아버지", "rom": "abeoji", "en": "father", "pos": "noun", "moduleId": "m4", "notes": "The respectful form. At home: 아빠." },
  { "id": "w_eomma", "ko": "엄마", "rom": "eomma", "en": "mom", "pos": "noun", "moduleId": "m4" },
  { "id": "w_appa", "ko": "아빠", "rom": "appa", "en": "dad", "pos": "noun", "moduleId": "m4" },
  { "id": "w_eonni", "ko": "언니", "rom": "eonni", "en": "older sister (speaker is female)", "pos": "noun", "moduleId": "m4", "notes": "Also used for close older female friends — not just blood family." },
  { "id": "w_nuna", "ko": "누나", "rom": "nuna", "en": "older sister (speaker is male)", "pos": "noun", "moduleId": "m4" },
  { "id": "w_oppa", "ko": "오빠", "rom": "oppa", "en": "older brother (speaker is female)", "pos": "noun", "moduleId": "m4", "notes": "Yes, the word from every K-drama. Also used for close older male friends (and boyfriends)." },
  { "id": "w_hyeong", "ko": "형", "rom": "hyeong", "en": "older brother (speaker is male)", "pos": "noun", "moduleId": "m4", "notes": "Also for close older male friends of a male speaker." },
  { "id": "w_dongsaeng", "ko": "동생", "rom": "dongsaeng", "en": "younger sibling", "pos": "noun", "moduleId": "m4", "notes": "Genderless — 여동생 / 남동생 specify sister / brother." },
  { "id": "w_halmeoni", "ko": "할머니", "rom": "halmeoni", "en": "grandmother", "pos": "noun", "moduleId": "m4" },
  { "id": "w_harabeoji", "ko": "할아버지", "rom": "harabeoji", "en": "grandfather", "pos": "noun", "moduleId": "m4" },
  { "id": "w_ai", "ko": "아이", "rom": "ai", "en": "child", "pos": "noun", "moduleId": "m4", "notes": "Often shortened to 애 in speech." },
  { "id": "w_adeul", "ko": "아들", "rom": "adeul", "en": "son", "pos": "noun", "moduleId": "m4" },
  { "id": "w_ttal", "ko": "딸", "rom": "ttal", "en": "daughter", "pos": "noun", "moduleId": "m4" },
  { "id": "w_namja", "ko": "남자", "rom": "namja", "en": "man / male", "pos": "noun", "moduleId": "m4" },
  { "id": "w_yeoja", "ko": "여자", "rom": "yeoja", "en": "woman / female", "pos": "noun", "moduleId": "m4" },
  { "id": "w_seonsaengnim", "ko": "선생님", "rom": "seonsaengnim", "en": "teacher", "pos": "noun", "moduleId": "m4", "notes": "선생 + 님. Also the polite way to address strangers you respect — like \"sir/ma'am.\"" },
  { "id": "w_uri", "ko": "우리", "rom": "uri", "en": "we / our — and \"my\" for shared things", "pos": "noun", "moduleId": "m4", "notes": "우리 엄마, 우리 집, 우리 나라 — \"my\" mom/house/country, said as \"our.\" The gap deck has the story." },
  { "id": "w_haksaeng", "ko": "학생", "rom": "haksaeng", "en": "student", "pos": "noun", "moduleId": "m4" },
  { "id": "w_uisa", "ko": "의사", "rom": "uisa", "en": "doctor", "pos": "noun", "moduleId": "m4", "notes": "Address one as 의사 선생님." },
  { "id": "w_hoesawon", "ko": "회사원", "rom": "hoesawon", "en": "office worker", "pos": "noun", "moduleId": "m4", "notes": "회사 (company) + 원 (member) — you already own half this word." },
  { "id": "w_yorisa", "ko": "요리사", "rom": "yorisa", "en": "cook / chef", "pos": "noun", "moduleId": "m4", "notes": "요리 + 사 (professional). Same -사 as in 의사." },
  { "id": "w_gasu", "ko": "가수", "rom": "gasu", "en": "singer", "pos": "noun", "moduleId": "m4" },
  { "id": "w_nai", "ko": "나이", "rom": "nai", "en": "age", "pos": "noun", "moduleId": "m4", "notes": "For elders, the word itself upgrades: 연세. Honorifics swap nouns too." },
  { "id": "w_mal", "ko": "말", "rom": "mal", "en": "speech / words / language", "pos": "noun", "moduleId": "m4", "notes": "The 말 in 반말 (\"half-speech\") and 한국말 (colloquial for 한국어)." },

  { "id": "w_salda", "ko": "살다", "rom": "salda", "en": "to live", "pos": "verb", "moduleId": "m4", "notes": "Polite: 살아요. Where you live takes 에: 한국에 살아요." },
  { "id": "w_malhada", "ko": "말하다", "rom": "malhada", "en": "to speak / say", "pos": "verb", "moduleId": "m4", "notes": "말 + 하다. Polite: 말해요." },
  { "id": "w_alda", "ko": "알다", "rom": "alda", "en": "to know", "pos": "verb", "moduleId": "m4", "notes": "Polite: 알아요 — also the everyday \"got it / I see.\"" },
  { "id": "w_moreuda", "ko": "모르다", "rom": "moreuda", "en": "to not know", "pos": "verb", "moduleId": "m4", "notes": "Polite: 몰라요 (mollayo) — a 르-irregular like 배불러요. Its own word, not 안 알다." },
  { "id": "w_deusida", "ko": "드시다", "rom": "deusida", "en": "to eat / drink (honorific)", "pos": "verb", "moduleId": "m4", "notes": "What elders do instead of 먹다. Polite: 드세요." },
  { "id": "w_gyesida", "ko": "계시다", "rom": "gyesida", "en": "to be / exist (honorific)", "pos": "verb", "moduleId": "m4", "notes": "있다 for respected people. Polite: 계세요." },
  { "id": "w_bappeuda", "ko": "바쁘다", "rom": "bappeuda", "en": "to be busy", "pos": "adj", "moduleId": "m4", "notes": "Polite: 바빠요 — the ㅡ drops, same as 배고프다 → 배고파요." },
  { "id": "w_chinjeolhada", "ko": "친절하다", "rom": "chinjeolhada", "en": "to be kind", "pos": "adj", "moduleId": "m4", "notes": "Polite: 친절해요." },

  { "id": "w_annyeong", "ko": "안녕", "rom": "annyeong", "en": "hi / bye (casual)", "pos": "phrase", "moduleId": "m4", "notes": "안녕하세요 with the politeness stripped off — friends only." },
  { "id": "w_joesong", "ko": "죄송합니다", "rom": "joesonghamnida", "en": "I'm sorry (formal)", "pos": "phrase", "moduleId": "m4", "notes": "The all-purpose formal apology — also \"excuse me\" when squeezing past someone." },
  { "id": "w_mianhaeyo", "ko": "미안해요", "rom": "mianhaeyo", "en": "sorry (casual-polite)", "pos": "phrase", "moduleId": "m4", "notes": "The ladder: 죄송합니다 → 미안해요 → 미안 (friends)." },
  { "id": "w_bangapseumnida", "ko": "만나서 반갑습니다", "rom": "mannaseo bangapseumnida", "en": "nice to meet you", "pos": "phrase", "moduleId": "m4", "notes": "Literally \"having met you, I'm glad\" — and your first 합니다-style phrase in the wild." },

  { "id": "w_p_ssi", "ko": "씨", "rom": "ssi", "en": "name suffix — polite Mr./Ms.", "pos": "particle", "moduleId": "m4", "notes": "After a full or given name: 민수 씨. Never after your own name, never after a bare surname." },

  { "id": "w_hana", "ko": "하나", "rom": "hana", "en": "one (native)", "pos": "noun", "moduleId": "m5", "notes": "Before a counter it contracts: 한 — 커피 한 잔." },
  { "id": "w_dul", "ko": "둘", "rom": "dul", "en": "two (native)", "pos": "noun", "moduleId": "m5", "notes": "Before a counter: 두 — 두 명." },
  { "id": "w_set", "ko": "셋", "rom": "set", "en": "three (native)", "pos": "noun", "moduleId": "m5", "notes": "Before a counter: 세 — 세 시." },
  { "id": "w_net", "ko": "넷", "rom": "net", "en": "four (native)", "pos": "noun", "moduleId": "m5", "notes": "Before a counter: 네 — 네 명. Yes, it collides with 네 \"yes\" — context saves you." },
  { "id": "w_daseot", "ko": "다섯", "rom": "daseot", "en": "five (native)", "pos": "noun", "moduleId": "m5" },
  { "id": "w_yeoseot", "ko": "여섯", "rom": "yeoseot", "en": "six (native)", "pos": "noun", "moduleId": "m5" },
  { "id": "w_ilgop", "ko": "일곱", "rom": "ilgop", "en": "seven (native)", "pos": "noun", "moduleId": "m5" },
  { "id": "w_yeodeol", "ko": "여덟", "rom": "yeodeol", "en": "eight (native)", "pos": "noun", "moduleId": "m5", "notes": "That ㄼ 받침 reads as ㄹ here: yeodeol." },
  { "id": "w_ahop", "ko": "아홉", "rom": "ahop", "en": "nine (native)", "pos": "noun", "moduleId": "m5" },
  { "id": "w_yeol", "ko": "열", "rom": "yeol", "en": "ten (native)", "pos": "noun", "moduleId": "m5", "notes": "Stacks like Sino numbers: 열하나 11, 열둘 12…" },
  { "id": "w_seumul", "ko": "스물", "rom": "seumul", "en": "twenty (native)", "pos": "noun", "moduleId": "m5", "notes": "Before a counter: 스무 — 스무 살. Native numbers fade out past the 20s–30s in real use; Sino takes over." },

  { "id": "w_c_gae", "ko": "개", "rom": "gae", "en": "counter — things", "pos": "noun", "moduleId": "m5", "notes": "The general-purpose counter: 사과 두 개. When in doubt, 개." },
  { "id": "w_c_myeong", "ko": "명", "rom": "myeong", "en": "counter — people", "pos": "noun", "moduleId": "m5", "notes": "네 명 (four people). The honorific version is 분." },
  { "id": "w_c_mari", "ko": "마리", "rom": "mari", "en": "counter — animals", "pos": "noun", "moduleId": "m5", "notes": "Also for fish on a plate: 생선 두 마리." },
  { "id": "w_c_sal", "ko": "살", "rom": "sal", "en": "counter — years of age", "pos": "noun", "moduleId": "m5", "notes": "Always with native numbers: 열 살, 스무 살." },
  { "id": "w_c_si", "ko": "시", "rom": "si", "en": "counter — o'clock", "pos": "noun", "moduleId": "m5", "notes": "Native numbers: 세 시 (3 o'clock). The word 시간 you know is this 시 + 간." },
  { "id": "w_c_bun", "ko": "분", "rom": "bun", "en": "counter — minutes", "pos": "noun", "moduleId": "m5", "notes": "SINO numbers: 십 분 (10 minutes). Hours native, minutes Sino — the hybrid clock." },
  { "id": "w_c_jan", "ko": "잔", "rom": "jan", "en": "counter — cups / glasses", "pos": "noun", "moduleId": "m5", "notes": "커피 한 잔, 물 두 잔." },
  { "id": "w_c_byeong", "ko": "병", "rom": "byeong", "en": "counter — bottles", "pos": "noun", "moduleId": "m5", "notes": "맥주 두 병. Also the standalone word for \"bottle.\"" },
  { "id": "w_c_gwon", "ko": "권", "rom": "gwon", "en": "counter — books", "pos": "noun", "moduleId": "m5", "notes": "책 세 권 (three books)." },

  { "id": "w_myeot", "ko": "몇", "rom": "myeot", "en": "how many / what (with a counter)", "pos": "noun", "moduleId": "m5", "notes": "몇 시? what time · 몇 살? how old · 몇 명? how many people. Always paired with a counter." },
  { "id": "w_ban", "ko": "반", "rom": "ban", "en": "half", "pos": "noun", "moduleId": "m5", "notes": "두 시 반 = 2:30. Also \"class\" at school — context decides." },
  { "id": "w_ojeon", "ko": "오전", "rom": "ojeon", "en": "a.m. / morning hours", "pos": "noun", "moduleId": "m5" },
  { "id": "w_ohu", "ko": "오후", "rom": "ohu", "en": "p.m. / afternoon", "pos": "noun", "moduleId": "m5" },
  { "id": "w_maeil", "ko": "매일", "rom": "maeil", "en": "every day", "pos": "noun", "moduleId": "m5", "notes": "매 (every) + 일 (day) — you own both halves." },
  { "id": "w_sigye", "ko": "시계", "rom": "sigye", "en": "clock / watch", "pos": "noun", "moduleId": "m5", "notes": "시 (hour) + 계 (machine)." },
  { "id": "w_saengil", "ko": "생일", "rom": "saengil", "en": "birthday", "pos": "noun", "moduleId": "m5", "notes": "An elder's birthday upgrades to 생신 — the honorific-noun pattern from Module 4." },
  { "id": "w_yaksok", "ko": "약속", "rom": "yaksok", "en": "plans / appointment / promise", "pos": "noun", "moduleId": "m5", "notes": "약속 있어요 = \"I have plans.\" The gap deck has the story." },

  { "id": "w_woryoil", "ko": "월요일", "rom": "woryoil", "en": "Monday", "pos": "noun", "moduleId": "m5", "notes": "월 = moon. The days are named moon–fire–water–wood–metal–earth–sun." },
  { "id": "w_hwayoil", "ko": "화요일", "rom": "hwayoil", "en": "Tuesday", "pos": "noun", "moduleId": "m5", "notes": "화 = fire." },
  { "id": "w_suyoil", "ko": "수요일", "rom": "suyoil", "en": "Wednesday", "pos": "noun", "moduleId": "m5", "notes": "수 = water." },
  { "id": "w_mogyoil", "ko": "목요일", "rom": "mogyoil", "en": "Thursday", "pos": "noun", "moduleId": "m5", "notes": "목 = wood." },
  { "id": "w_geumyoil", "ko": "금요일", "rom": "geumyoil", "en": "Friday", "pos": "noun", "moduleId": "m5", "notes": "금 = metal/gold. Fri-yay is universal." },
  { "id": "w_toyoil", "ko": "토요일", "rom": "toyoil", "en": "Saturday", "pos": "noun", "moduleId": "m5", "notes": "토 = earth." },
  { "id": "w_iryoil", "ko": "일요일", "rom": "iryoil", "en": "Sunday", "pos": "noun", "moduleId": "m5", "notes": "일 = sun — a different 일 from \"one\" and \"day.\" Hanja tells them apart; context does it for you." },
  { "id": "w_yoil", "ko": "요일", "rom": "yoil", "en": "day of the week", "pos": "noun", "moduleId": "m5", "notes": "무슨 요일이에요? — \"what day is it?\" (무슨 = what kind, coming soon.)" },

  { "id": "w_wi", "ko": "위", "rom": "wi", "en": "top / above", "pos": "noun", "moduleId": "m6", "notes": "A NOUN, not a preposition: 책상 위 = \"the desk's topside.\" Add 에: 책상 위에 (on the desk)." },
  { "id": "w_arae", "ko": "아래", "rom": "arae", "en": "bottom / below", "pos": "noun", "moduleId": "m6", "notes": "밑 (mit) is an everyday synonym you'll also hear." },
  { "id": "w_ap", "ko": "앞", "rom": "ap", "en": "front", "pos": "noun", "moduleId": "m6", "notes": "집 앞에 — in front of the house." },
  { "id": "w_dwi", "ko": "뒤", "rom": "dwi", "en": "back / behind", "pos": "noun", "moduleId": "m6" },
  { "id": "w_yeop", "ko": "옆", "rom": "yeop", "en": "side / next to", "pos": "noun", "moduleId": "m6", "notes": "옆에 — beside. 옆집 is \"the house next door.\"" },
  { "id": "w_an_inside", "ko": "안", "rom": "an", "en": "inside", "pos": "noun", "moduleId": "m6", "notes": "A homograph of negation 안 — position 안 follows a noun (가방 안에); negation 안 precedes a verb." },
  { "id": "w_bak", "ko": "밖", "rom": "bak", "en": "outside", "pos": "noun", "moduleId": "m6", "notes": "밖에 나가요 — go outside." },
  { "id": "w_sai", "ko": "사이", "rom": "sai", "en": "between / the space between", "pos": "noun", "moduleId": "m6", "notes": "A하고 B 사이에 — between A and B. Also relational: 친구 사이 = \"(we're) friends.\"" },

  { "id": "w_yeogi", "ko": "여기", "rom": "yeogi", "en": "here (near me)", "pos": "noun", "moduleId": "m6" },
  { "id": "w_geogi", "ko": "거기", "rom": "geogi", "en": "there (near you)", "pos": "noun", "moduleId": "m6" },
  { "id": "w_jeogi", "ko": "저기", "rom": "jeogi", "en": "over there (far from both)", "pos": "noun", "moduleId": "m6", "notes": "Also the attention-getter: 저기요! — \"excuse me!\" in restaurants." },
  { "id": "w_eodi", "ko": "어디", "rom": "eodi", "en": "where", "pos": "noun", "moduleId": "m6", "notes": "어디에 있어요? — where is it? Your first question word gets official." },

  { "id": "w_oenjjok", "ko": "왼쪽", "rom": "oenjjok", "en": "left (side)", "pos": "noun", "moduleId": "m6", "notes": "왼 (left) + 쪽 (side/direction)." },
  { "id": "w_oreunjjok", "ko": "오른쪽", "rom": "oreunjjok", "en": "right (side)", "pos": "noun", "moduleId": "m6" },

  { "id": "w_eunhaeng", "ko": "은행", "rom": "eunhaeng", "en": "bank", "pos": "noun", "moduleId": "m6" },
  { "id": "w_byeongwon", "ko": "병원", "rom": "byeongwon", "en": "hospital / clinic", "pos": "noun", "moduleId": "m6", "notes": "Koreans go to the 병원 for a cold — it covers small clinics, not just big hospitals." },
  { "id": "w_yakguk", "ko": "약국", "rom": "yakguk", "en": "pharmacy", "pos": "noun", "moduleId": "m6", "notes": "약 (medicine) + 국 (bureau). Not the soup 국 — different hanja, same sound." },
  { "id": "w_gongwon", "ko": "공원", "rom": "gongwon", "en": "park", "pos": "noun", "moduleId": "m6" },
  { "id": "w_yeok", "ko": "역", "rom": "yeok", "en": "station (train / subway)", "pos": "noun", "moduleId": "m6", "notes": "서울역 — Seoul Station. Bus stops are 정류장 — later." },
  { "id": "w_hwajangsil", "ko": "화장실", "rom": "hwajangsil", "en": "bathroom / restroom", "pos": "noun", "moduleId": "m6", "notes": "Literally \"makeup room.\" The single most useful place-word in the language." },
  { "id": "w_pyeonuijeom", "ko": "편의점", "rom": "pyeonuijeom", "en": "convenience store", "pos": "noun", "moduleId": "m6", "notes": "The 24-hour heart of Korean daily life — GS25, CU, 세븐일레븐." },
  { "id": "w_baekhwajeom", "ko": "백화점", "rom": "baekhwajeom", "en": "department store", "pos": "noun", "moduleId": "m6", "notes": "백화 = \"a hundred goods.\"" },

  { "id": "w_beoseu", "ko": "버스", "rom": "beoseu", "en": "bus", "pos": "noun", "moduleId": "m6" },
  { "id": "w_jihacheol", "ko": "지하철", "rom": "jihacheol", "en": "subway", "pos": "noun", "moduleId": "m6", "notes": "지하 (underground) + 철 (iron rail)." },
  { "id": "w_taeksi", "ko": "택시", "rom": "taeksi", "en": "taxi", "pos": "noun", "moduleId": "m6" },

  { "id": "w_chaeksang", "ko": "책상", "rom": "chaeksang", "en": "desk", "pos": "noun", "moduleId": "m6", "notes": "책 (book) + 상 (table) — a book-table." },
  { "id": "w_uija", "ko": "의자", "rom": "uija", "en": "chair", "pos": "noun", "moduleId": "m6" },
  { "id": "w_chimdae", "ko": "침대", "rom": "chimdae", "en": "bed", "pos": "noun", "moduleId": "m6" },
  { "id": "w_mun", "ko": "문", "rom": "mun", "en": "door / gate", "pos": "noun", "moduleId": "m6" },
  { "id": "w_changmun", "ko": "창문", "rom": "changmun", "en": "window", "pos": "noun", "moduleId": "m6", "notes": "창 + 문 — a window-door." },
  { "id": "w_gabang", "ko": "가방", "rom": "gabang", "en": "bag", "pos": "noun", "moduleId": "m6", "notes": "Yes — the bag Father climbed into in the spacing interlude." },
  { "id": "w_haendeupon", "ko": "핸드폰", "rom": "haendeupon", "en": "cell phone", "pos": "noun", "moduleId": "m6", "notes": "Konglish: \"hand phone.\" The gap deck has the story." },

  { "id": "w_geotda", "ko": "걷다", "rom": "geotda", "en": "to walk", "pos": "verb", "moduleId": "m6", "notes": "ㄷ-irregular like 듣다: 걸어요, 걸었어요." },
  { "id": "w_tada", "ko": "타다", "rom": "tada", "en": "to ride / take (transport)", "pos": "verb", "moduleId": "m6", "notes": "Polite: 타요. What you ride takes 을/를: 버스를 타요." },
  { "id": "w_naerida", "ko": "내리다", "rom": "naerida", "en": "to get off / go down", "pos": "verb", "moduleId": "m6", "notes": "Polite: 내려요. 여기에서 내려요 — \"I'll get off here\" (magic taxi words)." },
  { "id": "w_chatda", "ko": "찾다", "rom": "chatda", "en": "to look for / find", "pos": "verb", "moduleId": "m6", "notes": "Polite: 찾아요. One verb covers both the searching and the finding." },

  { "id": "w_meolda", "ko": "멀다", "rom": "meolda", "en": "to be far", "pos": "adj", "moduleId": "m6", "notes": "Polite: 멀어요." },
  { "id": "w_gakkapda", "ko": "가깝다", "rom": "gakkapda", "en": "to be near", "pos": "adj", "moduleId": "m6", "notes": "Polite: 가까워요 — ㅂ-irregular, same move as 맵다 → 매워요." },

  { "id": "w_p_ro", "ko": "로", "rom": "ro", "en": "particle — toward / by means of (after a vowel or ㄹ)", "pos": "particle", "moduleId": "m6", "notes": "왼쪽으로? No — 왼쪽 ends in ㄱ. After vowels and ㄹ: 지하철로 (by subway)." },
  { "id": "w_p_euro", "ko": "으로", "rom": "euro", "en": "particle — toward / by means of (after a consonant)", "pos": "particle", "moduleId": "m6", "notes": "왼쪽으로 가요 — go (toward the) left. Direction or instrument; 에 marks the endpoint, (으)로 the heading." },
  { "id": "w_p_buteo", "ko": "부터", "rom": "buteo", "en": "particle — from / starting at (time)", "pos": "particle", "moduleId": "m6", "notes": "아홉 시부터 — from 9 o'clock. Space uses 에서 instead." },
  { "id": "w_p_kkaji", "ko": "까지", "rom": "kkaji", "en": "particle — until / as far as", "pos": "particle", "moduleId": "m6", "notes": "여섯 시까지 (until 6) · 학교까지 (as far as school). Pairs with 부터 for time, 에서 for space." },

  { "id": "w_saek", "ko": "색", "rom": "saek", "en": "color", "pos": "noun", "moduleId": "m7", "notes": "Every color word below is just [something] + 색." },
  { "id": "w_ppalgansaek", "ko": "빨간색", "rom": "ppalgansaek", "en": "red", "pos": "noun", "moduleId": "m7" },
  { "id": "w_paransaek", "ko": "파란색", "rom": "paransaek", "en": "blue", "pos": "noun", "moduleId": "m7", "notes": "Traditionally covers nature's green too — the gap deck has the story." },
  { "id": "w_noransaek", "ko": "노란색", "rom": "noransaek", "en": "yellow", "pos": "noun", "moduleId": "m7" },
  { "id": "w_geomeunsaek", "ko": "검은색", "rom": "geomeunsaek", "en": "black", "pos": "noun", "moduleId": "m7", "notes": "까만색 is the everyday synonym." },
  { "id": "w_hayansaek", "ko": "하얀색", "rom": "hayansaek", "en": "white", "pos": "noun", "moduleId": "m7" },
  { "id": "w_choroksaek", "ko": "초록색", "rom": "choroksaek", "en": "green", "pos": "noun", "moduleId": "m7" },

  { "id": "w_manta", "ko": "많다", "rom": "manta", "en": "to be many / much", "pos": "adj", "moduleId": "m7", "notes": "Polite: 많아요 (manayo) — the ㅎ goes silent. One of the most-used words in the language." },
  { "id": "w_jeokda", "ko": "적다", "rom": "jeokda", "en": "to be few / little", "pos": "adj", "moduleId": "m7", "notes": "Polite: 적어요." },
  { "id": "w_bissada", "ko": "비싸다", "rom": "bissada", "en": "to be expensive", "pos": "adj", "moduleId": "m7", "notes": "Polite: 비싸요." },
  { "id": "w_ssada", "ko": "싸다", "rom": "ssada", "en": "to be cheap", "pos": "adj", "moduleId": "m7", "notes": "Polite: 싸요. 비싸다 minus the 비 — an accidental mnemonic." },
  { "id": "w_gilda", "ko": "길다", "rom": "gilda", "en": "to be long", "pos": "adj", "moduleId": "m7", "notes": "Polite: 길어요." },
  { "id": "w_jjalda", "ko": "짧다", "rom": "jjalda", "en": "to be short", "pos": "adj", "moduleId": "m7", "notes": "Polite: 짧아요 (jjalbayo) — the buried ㅂ surfaces." },
  { "id": "w_nopda", "ko": "높다", "rom": "nopda", "en": "to be high / tall (things)", "pos": "adj", "moduleId": "m7", "notes": "Polite: 높아요. Buildings and mountains, not people." },
  { "id": "w_natda", "ko": "낮다", "rom": "natda", "en": "to be low", "pos": "adj", "moduleId": "m7", "notes": "Polite: 낮아요." },
  { "id": "w_jaemiitda", "ko": "재미있다", "rom": "jaemiitda", "en": "to be fun / interesting", "pos": "adj", "moduleId": "m7", "notes": "재미 (fun) + 있다 — 'fun exists.' Same factory as 맛있다. Polite: 재미있어요." },
  { "id": "w_jaemieopda", "ko": "재미없다", "rom": "jaemieopda", "en": "to be boring", "pos": "adj", "moduleId": "m7", "notes": "Fun doesn't exist: 재미없어요." },
  { "id": "w_swipda", "ko": "쉽다", "rom": "swipda", "en": "to be easy", "pos": "adj", "moduleId": "m7", "notes": "Polite: 쉬워요 — ㅂ-irregular, the 맵다 family." },
  { "id": "w_eoryeopda", "ko": "어렵다", "rom": "eoryeopda", "en": "to be difficult", "pos": "adj", "moduleId": "m7", "notes": "Polite: 어려워요 — ㅂ-irregular." },
  { "id": "w_ttatteuthada", "ko": "따뜻하다", "rom": "ttatteuthada", "en": "to be warm", "pos": "adj", "moduleId": "m7", "notes": "Polite: 따뜻해요. Weather, coffee, and people can all be 따뜻하다." },
  { "id": "w_siwonhada", "ko": "시원하다", "rom": "siwonhada", "en": "to be cool / refreshing", "pos": "adj", "moduleId": "m7", "notes": "Polite: 시원해요 — famously also said about hot soup; the gap deck explains." },
  { "id": "w_kkaekkeuthada", "ko": "깨끗하다", "rom": "kkaekkeuthada", "en": "to be clean", "pos": "adj", "moduleId": "m7", "notes": "Polite: 깨끗해요." },

  { "id": "w_gibun", "ko": "기분", "rom": "gibun", "en": "mood / feeling", "pos": "noun", "moduleId": "m7", "notes": "기분이 좋아요 — I feel good. Your inner weather." },
  { "id": "w_haengbokhada", "ko": "행복하다", "rom": "haengbokhada", "en": "to be happy", "pos": "adj", "moduleId": "m7", "notes": "Polite: 행복해요. The deep kind; a good mood is 기분이 좋다." },
  { "id": "w_seulpeuda", "ko": "슬프다", "rom": "seulpeuda", "en": "to be sad", "pos": "adj", "moduleId": "m7", "notes": "Polite: 슬퍼요 — ㅡ drops, the 바쁘다/배고프다 family." },
  { "id": "w_pigonhada", "ko": "피곤하다", "rom": "pigonhada", "en": "to be tired", "pos": "adj", "moduleId": "m7", "notes": "Polite: 피곤해요. Korea's most-heard answer to 'how are you.'" },
  { "id": "w_gwaenchanta", "ko": "괜찮다", "rom": "gwaenchanta", "en": "to be okay / fine", "pos": "adj", "moduleId": "m7", "notes": "Polite: 괜찮아요 (gwaenchanayo). Comfort, decline, reassure — one word, three jobs; see the gap deck." },
  { "id": "w_simsimhada", "ko": "심심하다", "rom": "simsimhada", "en": "to be bored", "pos": "adj", "moduleId": "m7", "notes": "Polite: 심심해요. YOU are bored; a boring THING is 재미없다." },

  { "id": "w_saranghada", "ko": "사랑하다", "rom": "saranghada", "en": "to love", "pos": "verb", "moduleId": "m7", "notes": "사랑해요 — a complete sentence, subject and object understood." },
  { "id": "w_utda", "ko": "웃다", "rom": "utda", "en": "to laugh / smile", "pos": "verb", "moduleId": "m7", "notes": "Polite: 웃어요 (useoyo)." },
  { "id": "w_ulda", "ko": "울다", "rom": "ulda", "en": "to cry", "pos": "verb", "moduleId": "m7", "notes": "Polite: 울어요." },

  { "id": "w_nalssi", "ko": "날씨", "rom": "nalssi", "en": "weather", "pos": "noun", "moduleId": "m7", "notes": "날씨가 좋아요 — small talk's load-bearing wall. The full weather kit arrives in Module 11." },
  { "id": "w_kkot", "ko": "꽃", "rom": "kkot", "en": "flower", "pos": "noun", "moduleId": "m7" },
  { "id": "w_norae", "ko": "노래", "rom": "norae", "en": "song", "pos": "noun", "moduleId": "m7", "notes": "노래하다 = to sing. The 노래 a 가수 sings." },
  { "id": "w_munje", "ko": "문제", "rom": "munje", "en": "problem / question (on a test)", "pos": "noun", "moduleId": "m7", "notes": "문제없어요 — no problem!" },
  { "id": "w_ot", "ko": "옷", "rom": "ot", "en": "clothes", "pos": "noun", "moduleId": "m7", "notes": "The full shopping wardrobe arrives in Module 21." },

  { "id": "w_geurigo", "ko": "그리고", "rom": "geurigo", "en": "and (starting a sentence)", "pos": "phrase", "moduleId": "m7", "notes": "Joins sentences, where 하고 joins nouns." },
  { "id": "w_geureonde", "ko": "그런데", "rom": "geureonde", "en": "but / by the way", "pos": "phrase", "moduleId": "m7", "notes": "The soft pivot — contradiction or just a topic change. Shortens to 근데 in speech." },
  { "id": "w_hajiman", "ko": "하지만", "rom": "hajiman", "en": "but / however", "pos": "phrase", "moduleId": "m7", "notes": "The firmer 'but' — a real contrast is coming." },
  { "id": "w_geuraeseo", "ko": "그래서", "rom": "geuraeseo", "en": "so / therefore", "pos": "phrase", "moduleId": "m7", "notes": "Cause, then 그래서, then result." },

  { "id": "w_ireonada", "ko": "일어나다", "rom": "ireonada", "en": "to get up / wake up", "pos": "verb", "moduleId": "m8", "notes": "Polite: 일어나요. Also 'to stand up' and 'to happen' — context decides." },
  { "id": "w_ssitda", "ko": "씻다", "rom": "ssitda", "en": "to wash", "pos": "verb", "moduleId": "m8", "notes": "Polite: 씻어요. Hands, face, or yourself generally." },
  { "id": "w_dakda", "ko": "닦다", "rom": "dakda", "en": "to brush / wipe / polish", "pos": "verb", "moduleId": "m8", "notes": "Polite: 닦아요. Teeth, windows, shoes — anything you rub clean." },
  { "id": "w_syawohada", "ko": "샤워하다", "rom": "syawohada", "en": "to shower", "pos": "verb", "moduleId": "m8", "notes": "Loanword + 하다: 샤워해요." },
  { "id": "w_ipda", "ko": "입다", "rom": "ipda", "en": "to wear / put on (clothes)", "pos": "verb", "moduleId": "m8", "notes": "Polite: 입어요. Clothes only — shoes and hats get their own verbs later." },
  { "id": "w_junbihada", "ko": "준비하다", "rom": "junbihada", "en": "to prepare / get ready", "pos": "verb", "moduleId": "m8", "notes": "Polite: 준비해요." },
  { "id": "w_nagada", "ko": "나가다", "rom": "nagada", "en": "to go out", "pos": "verb", "moduleId": "m8", "notes": "나 (out) + 가다 (go). 밖에 나가요 — head outside. Its mirror 나오다 (come out) works the same way." },
  { "id": "w_sijakhada", "ko": "시작하다", "rom": "sijakhada", "en": "to start", "pos": "verb", "moduleId": "m8", "notes": "Polite: 시작해요." },
  { "id": "w_kkeunnada", "ko": "끝나다", "rom": "kkeunnada", "en": "to end / be over", "pos": "verb", "moduleId": "m8", "notes": "Polite: 끝나요. The thing itself ends: 영화가 끝나요." },
  { "id": "w_swida", "ko": "쉬다", "rom": "swida", "en": "to rest", "pos": "verb", "moduleId": "m8", "notes": "Polite: 쉬어요. 푹 쉬세요 — 'rest well' — is what you wish a tired friend." },
  { "id": "w_undonghada", "ko": "운동하다", "rom": "undonghada", "en": "to exercise / work out", "pos": "verb", "moduleId": "m8", "notes": "운동 (movement) + 하다: 운동해요." },
  { "id": "w_cheongsohada", "ko": "청소하다", "rom": "cheongsohada", "en": "to clean (a space)", "pos": "verb", "moduleId": "m8", "notes": "Polite: 청소해요. Rooms and houses — wiping objects is 닦다." },
  { "id": "w_ppallaehada", "ko": "빨래하다", "rom": "ppallaehada", "en": "to do laundry", "pos": "verb", "moduleId": "m8", "notes": "Polite: 빨래해요. 빨래 alone is the laundry itself." },
  { "id": "w_jeonhwahada", "ko": "전화하다", "rom": "jeonhwahada", "en": "to call (on the phone)", "pos": "verb", "moduleId": "m8", "notes": "Polite: 전화해요. The person you call takes 한테/에게 — a particle pair arriving soon; for now, just call." },
  { "id": "w_gidarida", "ko": "기다리다", "rom": "gidarida", "en": "to wait", "pos": "verb", "moduleId": "m8", "notes": "Polite: 기다려요. What you wait FOR takes 을/를: 친구를 기다려요." },
  { "id": "w_dochakhada", "ko": "도착하다", "rom": "dochakhada", "en": "to arrive", "pos": "verb", "moduleId": "m8", "notes": "Polite: 도착해요. Arrive AT a place takes 에: 집에 도착해요." },
  { "id": "w_chulbalhada", "ko": "출발하다", "rom": "chulbalhada", "en": "to depart / leave", "pos": "verb", "moduleId": "m8", "notes": "Polite: 출발해요. 도착하다's opposite number." },
  { "id": "w_neutda", "ko": "늦다", "rom": "neutda", "en": "to be late", "pos": "adj", "moduleId": "m8", "notes": "Polite: 늦어요. 늦었어요 — 'I'm late!' (Korean states it in the past — the being-late already happened.)" },

  { "id": "w_haru", "ko": "하루", "rom": "haru", "en": "a day / one day", "pos": "noun", "moduleId": "m8", "notes": "The native word — 하루가 길어요, 'the day is long.'" },
  { "id": "w_bam", "ko": "밤", "rom": "bam", "en": "night", "pos": "noun", "moduleId": "m8", "notes": "Completes the day: 아침 → 점심 → 저녁 → 밤. Also 'chestnut' — context decides." },
  { "id": "w_ju", "ko": "주", "rom": "ju", "en": "week", "pos": "noun", "moduleId": "m8", "notes": "다음 주 (next week), 이번 주 (this week). 일주일 = one full week." },
  { "id": "w_daeum", "ko": "다음", "rom": "daeum", "en": "next", "pos": "noun", "moduleId": "m8", "notes": "다음 주 (next week), 다음 역 (next station — listen for it on the subway)." },
  { "id": "w_bang", "ko": "방", "rom": "bang", "en": "room", "pos": "noun", "moduleId": "m8", "notes": "The 방 Father entered in the spacing joke. Also in 노래방 (karaoke room) and PC방." },
  { "id": "w_sinmun", "ko": "신문", "rom": "sinmun", "en": "newspaper", "pos": "noun", "moduleId": "m8", "notes": "신문을 읽어요 — the classic morning verb-noun pair." },
  { "id": "w_i_tooth", "ko": "이", "rom": "i", "en": "tooth / teeth", "pos": "noun", "moduleId": "m8", "notes": "Yes, another 이 — the gap deck celebrates this overworked syllable. 이를 닦아요 = brush your teeth." },
  { "id": "w_eolgul", "ko": "얼굴", "rom": "eolgul", "en": "face", "pos": "noun", "moduleId": "m8", "notes": "얼굴을 씻어요 — wash your face." },
  { "id": "w_son", "ko": "손", "rom": "son", "en": "hand", "pos": "noun", "moduleId": "m8", "notes": "손을 씻어요 — wash your hands." },
  { "id": "w_meori", "ko": "머리", "rom": "meori", "en": "head / hair", "pos": "noun", "moduleId": "m8", "notes": "Head and the hair on it share one word. 머리가 좋아요 (smart) lives in the gap deck." },
  { "id": "w_tibi", "ko": "티비", "rom": "tibi", "en": "TV", "pos": "noun", "moduleId": "m8", "notes": "Also spelled 텔레비전 in full — nobody has time for that." },
  { "id": "w_geim", "ko": "게임", "rom": "geim", "en": "game / video game", "pos": "noun", "moduleId": "m8", "notes": "게임(을) 해요 — 하다 as 'to play.'" },
  { "id": "w_gyehoek", "ko": "계획", "rom": "gyehoek", "en": "a plan", "pos": "noun", "moduleId": "m8", "notes": "주말 계획 — weekend plans. Softer than 약속 (which involves other people)." },
  { "id": "w_kkum", "ko": "꿈", "rom": "kkum", "en": "dream", "pos": "noun", "moduleId": "m8", "notes": "Both kinds — the sleeping kind and the life-goal kind. 꿈이 있어요." },

  { "id": "w_botong", "ko": "보통", "rom": "botong", "en": "usually", "pos": "noun", "moduleId": "m8", "notes": "Sits before the verb (or the whole sentence). Also 'ordinary' as a noun." },
  { "id": "w_hangsang", "ko": "항상", "rom": "hangsang", "en": "always", "pos": "noun", "moduleId": "m8" },
  { "id": "w_jaju", "ko": "자주", "rom": "jaju", "en": "often", "pos": "noun", "moduleId": "m8" },
  { "id": "w_gakkeum", "ko": "가끔", "rom": "gakkeum", "en": "sometimes", "pos": "noun", "moduleId": "m8" },
  { "id": "w_iljjik", "ko": "일찍", "rom": "iljjik", "en": "early", "pos": "noun", "moduleId": "m8", "notes": "일찍 일어나요 — get up early. Its opposite is 늦게 (from 늦다)." },
  { "id": "w_meonjeo", "ko": "먼저", "rom": "meonjeo", "en": "first / before others", "pos": "noun", "moduleId": "m8", "notes": "먼저 가요 — 'I'll head out first,' the polite office goodbye." },
  { "id": "w_najung", "ko": "나중", "rom": "najung", "en": "later (as 나중에)", "pos": "noun", "moduleId": "m8", "notes": "Almost always worn with 에: 나중에 — 'later!' A promise and a deferral in one word." }
]
