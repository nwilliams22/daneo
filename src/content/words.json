  { "id": "w_hangugeo", "ko": "한국어", "rom": "hangugeo", "en": "the Korean language", "pos": "noun", "moduleId": "m1" },
  { "id": "w_meokda", "ko": "먹다", "rom": "meokda", "en": "to eat", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 먹어요 (meogeoyo)." },
  { "id": "w_masida", "ko": "마시다", "rom": "masida", "en": "to drink", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 마셔요 (masyeoyo)." },
  { "id": "w_gada", "ko": "가다", "rom": "gada", "en": "to go", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 가요 (gayo)." },
  { "id": "w_oda", "ko": "오다", "rom": "oda", "en": "to come", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 와요 (wayo)." },
  { "id": "w_boda", "ko": "보다", "rom": "boda", "en": "to see / watch", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 봐요 (bwayo)." },
  { "id": "w_hada", "ko": "하다", "rom": "hada", "en": "to do", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 해요 (haeyo). Any ~하다 verb conjugates the same way." },
  { "id": "w_gongbuhada", "ko": "공부하다", "rom": "gongbuhada", "en": "to study", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 공부해요 (gongbuhaeyo)." },
  { "id": "w_joahada", "ko": "좋아하다", "rom": "joahada", "en": "to like", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 좋아해요 (joahaeyo)." },
  { "id": "w_itda", "ko": "있다", "rom": "itda", "en": "to exist / to have", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 있어요 (isseoyo). Korean has no separate everyday verb for possession — things simply exist (for you)." },
  { "id": "w_eopda", "ko": "없다", "rom": "eopda", "en": "to not exist / not have", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 없어요 (eopseoyo)." },
  { "id": "w_jada", "ko": "자다", "rom": "jada", "en": "to sleep", "pos": "verb", "moduleId": "m1", "notes": "Polite form: 자요 (jayo)." },
  { "id": "w_jota", "ko": "좋다", "rom": "jota", "en": "to be good", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 좋아요 (joayo). Korean describing words behave like verbs." },
  { "id": "w_masitda", "ko": "맛있다", "rom": "masitda", "en": "to be delicious", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 맛있어요 (masisseoyo). Literally 맛 (taste) + 있다 (exists)." },
  { "id": "w_yeppeuda", "ko": "예쁘다", "rom": "yeppeuda", "en": "to be pretty", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 예뻐요 (yeppeoyo)." },
  { "id": "w_keuda", "ko": "크다", "rom": "keuda", "en": "to be big", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 커요 (keoyo)." },
  { "id": "w_jakda", "ko": "작다", "rom": "jakda", "en": "to be small", "pos": "adj", "moduleId": "m1", "notes": "Polite form: 작아요 (jagayo)." },
  { "id": "w_annyeonghaseyo", "ko": "안녕하세요", "rom": "annyeonghaseyo", "en": "hello", "pos": "phrase", "moduleId": "m1", "notes": "The standard polite greeting. Between close friends it shortens to just 안녕 (annyeong)." },
  { "id": "w_gamsahamnida", "ko": "감사합니다", "rom": "gamsahamnida", "en": "thank you (formal)", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_gomawoyo", "ko": "고마워요", "rom": "gomawoyo", "en": "thanks (casual-polite)", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_ne", "ko": "네", "rom": "ne", "en": "yes", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_aniyo", "ko": "아니요", "rom": "aniyo", "en": "no", "pos": "phrase", "moduleId": "m1" },
  { "id": "w_p_eun", "ko": "은", "rom": "eun", "en": "topic particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "\"As for ___\": 밥은 (bap-eun)." },
  { "id": "w_p_neun", "ko": "는", "rom": "neun", "en": "topic particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "\"As for ___\": 저는 (jeo-neun)." },
  { "id": "w_p_i", "ko": "이", "rom": "i", "en": "subject particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "사람이 (saram-i)." },
  { "id": "w_p_ga", "ko": "가", "rom": "ga", "en": "subject particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "친구가 (chingu-ga). Irregulars: 저+가 → 제가, 나+가 → 내가." },
  { "id": "w_p_eul", "ko": "을", "rom": "eul", "en": "object particle (after consonant)", "pos": "particle", "moduleId": "m1", "notes": "밥을 (bap-eul)." },
  { "id": "w_p_reul", "ko": "를", "rom": "reul", "en": "object particle (after vowel)", "pos": "particle", "moduleId": "m1", "notes": "커피를 (keopi-reul)." },
  { "id": "w_p_e", "ko": "에", "rom": "e", "en": "location particle — to / at", "pos": "particle", "moduleId": "m1", "notes": "집에 (jip-e, \"to home\"), 학교에 (hakgyo-e, \"to school\")." },

  { "id": "w_n_il", "ko": "일", "rom": "il", "en": "one (1)", "pos": "noun", "moduleId": "m2", "notes": "Sino-Korean. Also means \"day\" and \"work\" — context decides." },
  { "id": "w_n_i", "ko": "이", "rom": "i", "en": "two (2)", "pos": "noun", "moduleId": "m2", "notes": "Sino-Korean. Looks like 일 (1) minus the ㄹ — a classic mix-up." },
  { "id": "w_n_sam", "ko": "삼", "rom": "sam", "en": "three (3)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_sa", "ko": "사", "rom": "sa", "en": "four (4)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_o", "ko": "오", "rom": "o", "en": "five (5)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_yuk", "ko": "육", "rom": "yuk", "en": "six (6)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_chil", "ko": "칠", "rom": "chil", "en": "seven (7)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_pal", "ko": "팔", "rom": "pal", "en": "eight (8)", "pos": "noun", "moduleId": "m2", "notes": "Also means \"arm\"." },
  { "id": "w_n_gu", "ko": "구", "rom": "gu", "en": "nine (9)", "pos": "noun", "moduleId": "m2" },
  { "id": "w_n_sip", "ko": "십", "rom": "sip", "en": "ten (10)", "pos": "noun", "moduleId": "m2", "notes": "Stack to count: 십일 11, 이십 20, 이십일 21 … 구십구 99." },

  { "id": "w_oneul", "ko": "오늘", "rom": "oneul", "en": "today", "pos": "noun", "moduleId": "m2" },
  { "id": "w_eoje", "ko": "어제", "rom": "eoje", "en": "yesterday", "pos": "noun", "moduleId": "m2" },
  { "id": "w_naeil", "ko": "내일", "rom": "naeil", "en": "tomorrow", "pos": "noun", "moduleId": "m2", "notes": "Literally 내(來 coming)+일(day) — \"the coming day\"." },
  { "id": "w_jigeum", "ko": "지금", "rom": "jigeum", "en": "now", "pos": "noun", "moduleId": "m2" },
  { "id": "w_achim", "ko": "아침", "rom": "achim", "en": "morning / breakfast", "pos": "noun", "moduleId": "m2", "notes": "Also means breakfast — 아침 먹었어요? \"had breakfast?\"" },
  { "id": "w_jeonyeok", "ko": "저녁", "rom": "jeonyeok", "en": "evening / dinner", "pos": "noun", "moduleId": "m2", "notes": "Same double duty as 아침: the time and the meal." },
  { "id": "w_jumal", "ko": "주말", "rom": "jumal", "en": "weekend", "pos": "noun", "moduleId": "m2" },

  { "id": "w_kape", "ko": "카페", "rom": "kape", "en": "cafe", "pos": "noun", "moduleId": "m2" },
  { "id": "w_doseogwan", "ko": "도서관", "rom": "doseogwan", "en": "library", "pos": "noun", "moduleId": "m2" },
  { "id": "w_hoesa", "ko": "회사", "rom": "hoesa", "en": "company / the office", "pos": "noun", "moduleId": "m2", "notes": "Koreans say 회사에 가요 (\"go to the company\") for \"go to work\"." },
  { "id": "w_sikdang", "ko": "식당", "rom": "sikdang", "en": "restaurant", "pos": "noun", "moduleId": "m2" },

  { "id": "w_yeonghwa", "ko": "영화", "rom": "yeonghwa", "en": "movie", "pos": "noun", "moduleId": "m2" },
  { "id": "w_eumak", "ko": "음악", "rom": "eumak", "en": "music", "pos": "noun", "moduleId": "m2" },
  { "id": "w_ppang", "ko": "빵", "rom": "ppang", "en": "bread", "pos": "noun", "moduleId": "m2", "notes": "Starts with tense ㅃ — puff-free and tight." },
  { "id": "w_uyu", "ko": "우유", "rom": "uyu", "en": "milk", "pos": "noun", "moduleId": "m2", "notes": "All vowels-with-ㅇ: 우+유. Good ㅜ/ㅠ practice." },
  { "id": "w_cha", "ko": "차", "rom": "cha", "en": "tea", "pos": "noun", "moduleId": "m2", "notes": "Also means \"car\" — context decides." },

  { "id": "w_ikda", "ko": "읽다", "rom": "ikda", "en": "to read", "pos": "verb", "moduleId": "m2", "notes": "Polite: 읽어요 (ilgeoyo) — the buried ㄹ comes back before a vowel." },
  { "id": "w_deutda", "ko": "듣다", "rom": "deutda", "en": "to listen", "pos": "verb", "moduleId": "m2", "notes": "ㄷ-irregular: 들어요 (deureoyo), past 들었어요." },
  { "id": "w_mannada", "ko": "만나다", "rom": "mannada", "en": "to meet", "pos": "verb", "moduleId": "m2", "notes": "Polite: 만나요. Past: 만났어요." },
  { "id": "w_sada", "ko": "사다", "rom": "sada", "en": "to buy", "pos": "verb", "moduleId": "m2", "notes": "Polite: 사요. Past: 샀어요." },
  { "id": "w_baeuda", "ko": "배우다", "rom": "baeuda", "en": "to learn", "pos": "verb", "moduleId": "m2", "notes": "Polite: 배워요 (ㅜ + 어 → 워). Past: 배웠어요." },
  { "id": "w_ilhada", "ko": "일하다", "rom": "ilhada", "en": "to work", "pos": "verb", "moduleId": "m2", "notes": "일 (work) + 하다 (do). Polite: 일해요. Past: 일했어요." },

  { "id": "w_p_do", "ko": "도", "rom": "do", "en": "particle — also / too", "pos": "particle", "moduleId": "m2", "notes": "REPLACES 은/는/이/가/을/를 — never stacks on them: 음악도, not 음악을도." },
  { "id": "w_p_eseo", "ko": "에서", "rom": "eseo", "en": "particle — at / in (where an action happens)", "pos": "particle", "moduleId": "m2", "notes": "카페에서 마셔요 (drink AT the cafe). 에 is the destination; 에서 is the venue." },
  { "id": "w_p_hago", "ko": "하고", "rom": "hago", "en": "particle — and / with", "pos": "particle", "moduleId": "m2", "notes": "우유하고 빵 (milk and bread) · 친구하고 (with a friend)." },

  { "id": "w_jeomsim", "ko": "점심", "rom": "jeomsim", "en": "lunch / midday", "pos": "noun", "moduleId": "m3", "notes": "Completes the meal set with 아침 and 저녁 — and like them, it's both the time and the meal." },
  { "id": "w_gimchi", "ko": "김치", "rom": "gimchi", "en": "kimchi", "pos": "noun", "moduleId": "m3" },
  { "id": "w_gogi", "ko": "고기", "rom": "gogi", "en": "meat", "pos": "noun", "moduleId": "m3", "notes": "Prefix the animal for specifics later: 소고기 beef, 돼지고기 pork." },
  { "id": "w_saengseon", "ko": "생선", "rom": "saengseon", "en": "fish (as food)", "pos": "noun", "moduleId": "m3", "notes": "Fish on a plate. A fish swimming in the sea is 물고기." },
  { "id": "w_gwail", "ko": "과일", "rom": "gwail", "en": "fruit", "pos": "noun", "moduleId": "m3" },
  { "id": "w_sagwa", "ko": "사과", "rom": "sagwa", "en": "apple", "pos": "noun", "moduleId": "m3", "notes": "Also means \"apology\" — 사과해요 is \"I apologize,\" not \"I apple.\"" },
  { "id": "w_banana", "ko": "바나나", "rom": "banana", "en": "banana", "pos": "noun", "moduleId": "m3", "notes": "A loanword that sounds like home. Korean is full of these." },
  { "id": "w_chaeso", "ko": "채소", "rom": "chaeso", "en": "vegetables", "pos": "noun", "moduleId": "m3", "notes": "야채 (yachae) is the everyday synonym you'll also hear." },
  { "id": "w_gyeran", "ko": "계란", "rom": "gyeran", "en": "egg", "pos": "noun", "moduleId": "m3", "notes": "The native-Korean word 달걀 means the same thing." },
  { "id": "w_guk", "ko": "국", "rom": "guk", "en": "soup", "pos": "noun", "moduleId": "m3", "notes": "Everyday soup that comes with rice. Fancier stews are 찌개 and 탕 — later." },
  { "id": "w_ramyeon", "ko": "라면", "rom": "ramyeon", "en": "ramen (instant noodles)", "pos": "noun", "moduleId": "m3" },
  { "id": "w_gimbap", "ko": "김밥", "rom": "gimbap", "en": "gimbap (seaweed rice roll)", "pos": "noun", "moduleId": "m3", "notes": "김 (seaweed) + 밥 (rice) — the name is the recipe." },
  { "id": "w_bulgogi", "ko": "불고기", "rom": "bulgogi", "en": "bulgogi (marinated beef)", "pos": "noun", "moduleId": "m3", "notes": "불 (fire) + 고기 (meat) — \"fire meat.\"" },
  { "id": "w_bibimbap", "ko": "비빔밥", "rom": "bibimbap", "en": "bibimbap (mixed rice bowl)", "pos": "noun", "moduleId": "m3", "notes": "비빔 (mixing) + 밥 (rice). Korean food names are honest." },
  { "id": "w_chikin", "ko": "치킨", "rom": "chikin", "en": "fried chicken", "pos": "noun", "moduleId": "m3", "notes": "The loanword means Korean fried chicken specifically — a national institution." },
  { "id": "w_banchan", "ko": "반찬", "rom": "banchan", "en": "side dishes", "pos": "noun", "moduleId": "m3", "notes": "The small shared plates that cover a Korean table. They refill for free." },
  { "id": "w_sogeum", "ko": "소금", "rom": "sogeum", "en": "salt", "pos": "noun", "moduleId": "m3" },
  { "id": "w_seoltang", "ko": "설탕", "rom": "seoltang", "en": "sugar", "pos": "noun", "moduleId": "m3" },
  { "id": "w_maekju", "ko": "맥주", "rom": "maekju", "en": "beer", "pos": "noun", "moduleId": "m3" },
  { "id": "w_soju", "ko": "소주", "rom": "soju", "en": "soju", "pos": "noun", "moduleId": "m3" },
  { "id": "w_juseu", "ko": "주스", "rom": "juseu", "en": "juice", "pos": "noun", "moduleId": "m3" },
  { "id": "w_menyu", "ko": "메뉴", "rom": "menyu", "en": "menu", "pos": "noun", "moduleId": "m3" },
  { "id": "w_siksa", "ko": "식사", "rom": "siksa", "en": "a meal (slightly formal)", "pos": "noun", "moduleId": "m3", "notes": "식사했어요? is a politer cousin of 밥 먹었어요?" },
  { "id": "w_bae", "ko": "배", "rom": "bae", "en": "stomach / belly", "pos": "noun", "moduleId": "m3", "notes": "Also \"pear\" and \"boat\" — context decides. It's the 배 in 배고프다." },
  { "id": "w_mateu", "ko": "마트", "rom": "mateu", "en": "supermarket", "pos": "noun", "moduleId": "m3", "notes": "From \"mart.\" The big-box grocery store." },
  { "id": "w_sijang", "ko": "시장", "rom": "sijang", "en": "market (traditional)", "pos": "noun", "moduleId": "m3" },

  { "id": "w_maepda", "ko": "맵다", "rom": "maepda", "en": "to be spicy", "pos": "adj", "moduleId": "m3", "notes": "Polite: 매워요 (maewoyo) — the ㅂ softens to 워. A whole ㅂ-irregular family works this way; it gets its own module later." },
  { "id": "w_jjada", "ko": "짜다", "rom": "jjada", "en": "to be salty", "pos": "adj", "moduleId": "m3", "notes": "Polite: 짜요 (jjayo)." },
  { "id": "w_dalda", "ko": "달다", "rom": "dalda", "en": "to be sweet", "pos": "adj", "moduleId": "m3", "notes": "Polite: 달아요 (darayo)." },
  { "id": "w_madeopda", "ko": "맛없다", "rom": "madeopda", "en": "to taste bad", "pos": "adj", "moduleId": "m3", "notes": "Polite: 맛없어요 (madeopseoyo). Literally \"taste doesn't exist\" — the mirror of 맛있다." },
  { "id": "w_baegopeuda", "ko": "배고프다", "rom": "baegopeuda", "en": "to be hungry", "pos": "adj", "moduleId": "m3", "notes": "Polite: 배고파요 (baegopayo) — the ㅡ drops before 아. Literally \"stomach is hungry.\"" },
  { "id": "w_baebureuda", "ko": "배부르다", "rom": "baebureuda", "en": "to be full (after eating)", "pos": "adj", "moduleId": "m3", "notes": "Polite: 배불러요 (baebulleoyo) — a 르-irregular; just memorize this one for now." },
  { "id": "w_silta", "ko": "싫다", "rom": "silta", "en": "to be unwanted / disliked", "pos": "adj", "moduleId": "m3", "notes": "Polite: 싫어요 (sireoyo). The blunt \"no thanks / I don't want it.\"" },

  { "id": "w_yorihada", "ko": "요리하다", "rom": "yorihada", "en": "to cook", "pos": "verb", "moduleId": "m3", "notes": "요리 (cooking) + 하다. Polite: 요리해요. Past: 요리했어요." },
  { "id": "w_jumunhada", "ko": "주문하다", "rom": "jumunhada", "en": "to order (at a restaurant)", "pos": "verb", "moduleId": "m3", "notes": "Polite: 주문해요. Past: 주문했어요." },
  { "id": "w_mandeulda", "ko": "만들다", "rom": "mandeulda", "en": "to make", "pos": "verb", "moduleId": "m3", "notes": "Polite: 만들어요 (mandeureoyo). Past: 만들었어요." },
  { "id": "w_sireohada", "ko": "싫어하다", "rom": "sireohada", "en": "to dislike", "pos": "verb", "moduleId": "m3", "notes": "The verb pair of 싫다, like 좋다/좋아하다. Polite: 싫어해요." },
